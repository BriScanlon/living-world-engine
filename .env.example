# ---------------------------------------------------------------------------
# Local-AI Tabletop VTT — configuration
# Copy to .env and adjust:   cp .env.example .env
# ---------------------------------------------------------------------------

# Port the VTT is published on (http://<this-machine>:VTT_PORT/table and /dm)
VTT_PORT=8000

# Where maps, thumbnails, the inbox and the SQLite DB live.
# Inside Docker this is the mounted volume; leave as /data.
DATA_DIR=/data

# --- AI pipeline -------------------------------------------------------------
# true  = no GPUs needed: simulated progress + procedural 4K test maps
# false = call the LAN GPU services below
MOCK_AI_PIPELINE=true

# OpenAI-compatible endpoint (Ollama: http://<gpu-box>:11434/v1, vLLM: http://<gpu-box>:8000/v1)
LLM_API_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
# Text model used to expand short DM descriptions into image + motion prompts
LLM_MODEL=qwen2.5:14b-instruct
# Vision model used to write motion prompts for imported Inkarnate maps
LLM_VISION_MODEL=qwen2.5vl:7b

# ComfyUI servers (can be the same box). Leave COMFY_VIDEO_URL empty to skip animation.
COMFY_IMAGE_URL=http://host.docker.internal:8188
COMFY_VIDEO_URL=http://host.docker.internal:8188
# Workflow templates (file names inside ./workflows)
COMFY_IMAGE_WORKFLOW=flux_battlemap.json
COMFY_VIDEO_WORKFLOW=wan21_flf2v_loop.json
# Max seconds to wait for a single ComfyUI job (Wan 14B can take a while)
COMFY_TIMEOUT_S=1800

# --- Watched folder ----------------------------------------------------------
# Drop PNG/WebP/JPG files into DATA_DIR/inbox to auto-animate + import them.
WATCH_INBOX=true
# Use filesystem polling instead of native events. Required when the data
# folder is a Docker bind mount from a Windows/macOS host.
INBOX_POLLING=true

# --- Display -----------------------------------------------------------------
# Initial 1" hex size in CSS px before calibration.
# 32" 4K panel = ~137.7 physical PPI; at 150% OS scaling that is ~91.8 CSS px.
DEFAULT_HEX_PX=91.8
