# ---------------------------------------------------------------------------
# Living World Engine — copy to .env and adjust.
# ---------------------------------------------------------------------------

# --- TerminusDB -------------------------------------------------------------
TERMINUSDB_ADMIN_PASS=root
TERMINUSDB_USER=admin
TERMINUSDB_TEAM=admin
TERMINUSDB_DB=living_world
# Host port for the TerminusDB dashboard / API (bound to 127.0.0.1 in docker-compose.yml: not reachable from the LAN)
TERMINUSDB_PORT=6363

# --- Backend ----------------------------------------------------------------
BACKEND_PORT=8000
# Seed the demo town into `main` on first start if the database is empty
SEED_ON_STARTUP=true
LOG_LEVEL=INFO

# --- LLM --------------------------------------------------------------------
# true = deterministic mock payloads, no GPU / model server needed
MOCK_LLM=true
# Any OpenAI-compatible endpoint (Ollama, vLLM, LM Studio, OpenAI, ...).
# From inside Docker, a LAN/host Ollama is usually http://host.docker.internal:11434/v1
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1:8b
LLM_TEMPERATURE=0.7
# json_object | json_schema | none  (how structured output is requested; json_schema is best with Ollama)
LLM_JSON_MODE=json_object
LLM_CONCURRENCY=4
LLM_TIMEOUT_SECONDS=120
# Retries per call (invalid JSON, cut-off replies, timeouts, 5xx). The SDK's own retries are off.
LLM_MAX_RETRIES=2
# Cap on each reply, so a looping model stops instead of running to the timeout (largest real reply ~1.5K)
LLM_MAX_TOKENS=4096
# The model's context window, if known (0 = unknown): warns before a prompt that likely won't fit with room for the
# reply. A reply cut off by the context window is always reported as such (and not retried).
LLM_CONTEXT_TOKENS=0
# Reasoning models only: none | low | medium | high, sent as reasoning_effort. "none" = no thinking
# before the JSON (e.g. qwen3.8). Leave empty for instruct models.
LLM_REASONING_EFFORT=

# --- Simulation -------------------------------------------------------------
# In-world days per simulation round, and the cap on rounds per forecast
ROUND_LENGTH_DAYS=3
MAX_ROUNDS=4
ACTIVATION_HOPS=2

# --- Optional heavy ingestion extras (baked in at image build time) --------
# docling pulls in PyTorch (~2 GB). Without it, PDF/DOCX fall back to pypdf / python-docx.
INSTALL_DOCLING=false
INSTALL_WHISPER=false
WHISPER_MODEL=base

# --- World Atlas ------------------------------------------------------------
# On first start, generate the sample planet (Azgaar Full JSON format), import it and place
# the Greywater demo on one of its port towns. Set false to start with no map.
ATLAS_SAMPLE_ON_STARTUP=true
# Forecast run records and checkpoints (default: runs/ beside the atlas folder, in the data volume)
# RUNS_DIR=
# TerminusDB database holding the homebrew library (custom creatures, peoples, items shared by every world)
HOMEBREW_DB=homebrew_library

# --- Virtual tabletop (vtt/) ------------------------------------------------
# http://<this-machine>:VTT_PORT/table on the table display, /dm on the DM's laptop/tablet
VTT_PORT=8080
# true = no GPUs needed: simulated progress + procedural 4K test maps
VTT_MOCK_AI_PIPELINE=true
# OpenAI-compatible endpoint used to turn a one-line description into image + motion prompts
VTT_LLM_API_URL=http://host.docker.internal:11434/v1
VTT_LLM_API_KEY=ollama
VTT_LLM_MODEL=qwen2.5:14b-instruct
VTT_LLM_VISION_MODEL=qwen2.5vl:7b
# ComfyUI (Flux stills, Wan 2.1 loops). Leave VTT_COMFY_VIDEO_URL empty to skip animation.
VTT_COMFY_IMAGE_URL=http://host.docker.internal:8188
VTT_COMFY_VIDEO_URL=http://host.docker.internal:8188
VTT_COMFY_IMAGE_WORKFLOW=flux_battlemap.json
VTT_COMFY_VIDEO_WORKFLOW=wan21_flf2v_loop.json
VTT_COMFY_TIMEOUT_S=1800
# Watched folder: drop PNG/WebP/JPG into the VTT's /data/inbox to auto-animate + import
VTT_WATCH_INBOX=true
VTT_INBOX_POLLING=true
# Initial 1" hex size in CSS px before calibration (32" 4K panel at 150% scaling = ~91.8)
VTT_DEFAULT_HEX_PX=91.8

# --- Map generator (fmg/) ---------------------------------------------------
# Azgaar's Fantasy Map Generator, self-hosted at http://<this-machine>:FMG_PORT (pinned upstream tag)
FMG_PORT=8070
FMG_REF=v1.157.0

# --- Frontend ---------------------------------------------------------------
FRONTEND_PORT=5173
